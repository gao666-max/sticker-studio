# demo: use bundled sample assets, no key needed
# dashscope: call DashScope qwen-image-3.0, requires DASHSCOPE_API_KEY
IMAGE_PROVIDER=demo

# Local convenience: if DASHSCOPE_API_KEY is empty, read the local DSH credential.
# Off by default. Set to 1 only on your own machine.
USE_DSH_CREDENTIALS=0

# Never commit a real key. Fill it here only on your own machine.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-image-3.0
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1

# Official qwen-image-3.0 list price, USD per image (see README)
DASHSCOPE_PRICE_INPUT_USD=0.00275
DASHSCOPE_PRICE_OUTPUT_USD=0.024754
USD_TO_CNY=7.1

# Kiosk
# 0.0.0.0 makes the kiosk reachable on your LAN; keep 127.0.0.1 for local only.
STUDIO_HOST=127.0.0.1
# The address a phone can open, used for the claim QR. Example: http://192.168.1.23:8787
PUBLIC_BASE_URL=
# motion = fast procedural loop, ai = slower 4x4 model call
KIOSK_GIF_MODE=motion
